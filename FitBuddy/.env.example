# Google Gemini API Key - Replace with your actual API key from Google AI Studio
GOOGLE_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g. gemini-3.1-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.1-flash-lite

# Application Environment (development, production)
APP_ENV=development
PORT=8000
